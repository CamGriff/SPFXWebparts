{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "tool-picker-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/toolPicker/ToolPickerWebPart.js",
          "manifest": "./src/webparts/toolPicker/ToolPickerWebPart.manifest.json"
        }
      ]
    },
    "tool-display-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/toolDisplay/ToolDisplayWebPart.js",
          "manifest": "./src/webparts/toolDisplay/ToolDisplayWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "ToolPickerWebPartStrings": "lib/webparts/toolPicker/loc/{locale}.js",
    "ToolDisplayWebPartStrings": "lib/webparts/toolDisplay/loc/{locale}.js"
  }
}
